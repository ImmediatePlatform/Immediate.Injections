<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<IsPackable>true</IsPackable>
	<IncludeBuildOutput>false</IncludeBuildOutput>

	<EnablePackageValidation>true</EnablePackageValidation>
	<PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
	<Title>Immediate.Injections</Title>
	<Description>Source-generated Microsoft.Extensions.DependencyInjection registrations.</Description>

	<Authors>Immediate.Injections Developers</Authors>
	<Copyright>© 2026 Immediate.Injections Developers</Copyright>

	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>readme.md</PackageReadmeFile>
	<PackageTags>csharp-sourcegenerator;ioc;dependency-injection;inversion-of-control;di;injection-container;injection-framework</PackageTags>

	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<RepositoryUrl>https://github.com/ImmediatePlatform/Immediate.Injections</RepositoryUrl>
  </PropertyGroup>

  <!--
	This ensures the library will be packaged as a source generator when we use `dotnet pack`
	-->
  <ItemGroup>
	<None Include="../../readme.md" Pack="true" PackagePath="/" />

	<!-- II.Shared -->
	<TfmSpecificPackageFile
	  Include="../Immediate.Injections.Shared/bin/$(Configuration)/$(TargetFramework)/Immediate.Injections.Shared.dll"
	  Pack="true"
	  PackagePath="lib/$(TargetFramework)" />

	<TfmSpecificPackageFile
	  Include="../Immediate.Injections.Shared/bin/$(Configuration)/$(TargetFramework)/Immediate.Injections.Shared.xml"
	  Pack="true"
	  PackagePath="lib/$(TargetFramework)" />
  </ItemGroup>

  <ItemGroup>
	<None
	  Include="../Immediate.Injections.Analyzers/bin/$(Configuration)/roslyn4.8/Immediate.Injections.Analyzers.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn4.8/cs" />

	<None
	  Include="../Immediate.Injections.Generators/bin/$(Configuration)/roslyn4.8/Immediate.Injections.Generators.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn4.8/cs" />
  </ItemGroup>

  <ItemGroup>
	<None
	  Include="../Immediate.Injections.Analyzers/bin/$(Configuration)/roslyn5.0/Immediate.Injections.Analyzers.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />

	<None
	  Include="../Immediate.Injections.Generators/bin/$(Configuration)/roslyn5.0/Immediate.Injections.Generators.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />

	<TfmSpecificPackageFile
	  Condition=" '$(TargetFramework)' == 'net8.0' "
	  Include="$(PkgScriban)/lib/net8.0/Scriban.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />
  </ItemGroup>

  <ItemGroup>
	<None
	  Include="../Immediate.Injections.Analyzers/bin/$(Configuration)/roslyn5.9/Immediate.Injections.Analyzers.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />

	<None
	  Include="../Immediate.Injections.Generators/bin/$(Configuration)/roslyn5.9/Immediate.Injections.Generators.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />

	<TfmSpecificPackageFile
	  Condition=" '$(TargetFramework)' == 'net8.0' "
	  Include="$(PkgScriban)/lib/net8.0/Scriban.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	<PackageReference Include="Scriban" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="../Immediate.Injections.Shared/Immediate.Injections.Shared.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
	<RoslynVersion Condition=" '$(TargetFramework)' == 'net8.0' ">roslyn4.8</RoslynVersion>
	<RoslynVersion Condition=" '$(TargetFramework)' == 'net10.0' ">roslyn5.0</RoslynVersion>
	<RoslynVersion Condition=" '$(TargetFramework)' == 'net11.0' ">roslyn5.9</RoslynVersion>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="../../src/Immediate.Injections.Analyzers/Immediate.Injections.Analyzers.csproj" ReferenceOutputAssembly="false">
	  <SetTargetFramework>TargetFramework=$(RoslynVersion)</SetTargetFramework>
	</ProjectReference>

	<ProjectReference Include="../../src/Immediate.Injections.Generators/Immediate.Injections.Generators.csproj" ReferenceOutputAssembly="false">
	  <SetTargetFramework>TargetFramework=$(RoslynVersion)</SetTargetFramework>
	</ProjectReference>
  </ItemGroup>

</Project>
